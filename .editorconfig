root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
# Aturan ktlint ditetapkan di build.gradle.kts (spotless.editorConfigOverride) agar
# perubahan aturan ikut terdeteksi oleh configuration cache Gradle.

[*.{yml,yaml,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
